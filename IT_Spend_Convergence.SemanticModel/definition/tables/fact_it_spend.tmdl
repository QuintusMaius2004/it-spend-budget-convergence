	partition fact_it_spend = m
		source =
				let
				    Source = Excel.Workbook(File.Contents("D:\Other\Subject\Data Analyst\Power BI\Project\1st PL-300 Datapot\Dataset\IT Spend Analysis Sample-no-PV.xlsx"), null, true),
				    Sheet = Source{[Item="Fact",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Sheet),
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers",{{"Date", "date"}, {"Value", "value"}, {"Department", "department_id"}, {"Cost Element ID", "cost_element_id"}, {"Business Area ID", "business_area_id"}, {"IT Sub Area ID", "it_sub_area_id"}, {"Scenario ID", "scenario_id"}, {"Country/Region ID", "region_id"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"date", type date}, {"department_id", type number}, {"cost_element_id", type number}, {"business_area_id", type number}, {"it_sub_area_id", type number}, {"scenario_id", type number}, {"region_id", type number}, {"value", type number}}),
				    #"Removed Blank Rows" = Table.SelectRows(#"Changed Type", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null})))
				in
				    #"Removed Blank Rows"

	annotation PBI_NavigationStepName = Navigation

