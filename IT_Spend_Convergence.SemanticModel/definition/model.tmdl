model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_business_area","dim_cost_element","dim_region","dim_date","dim_department","fact_it_spend","dim_it_area","dim_scenario"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_business_area
ref table dim_cost_element
ref table dim_region
ref table dim_date
ref table dim_department
ref table fact_it_spend
ref table dim_it_area
ref table dim_scenario

ref cultureInfo en-US

